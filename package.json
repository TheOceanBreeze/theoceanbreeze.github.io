{
  "name": "website",
  "version": "0.0.2",
  "description": "My personal website",
  "main": "index.js",
  "scripts": {
    "clean": "rm -rf docs",
    "build": "bun x eleventy",
    "start": "DEBUG=Eleventy* bun x eleventy --serve",
    "compile:sass": "bun x sass src/assets/sass/site.sass docs/assets/css/site.css --style=compressed --no-source-map",
    "prestart": "bun run clean",
    "prebuild": "bun run clean && bun run compile:sass"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheOceanBreeze/website.git"
  },
  "keywords": [
    "website",
    "personal",
    "blog",
    "portfolio",
    "gallery",
    "theoceanbreeze"
  ],
  "author": "TheOceanBreeze",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/TheOceanBreeze/website/issues"
  },
  "homepage": "https://github.com/TheOceanBreeze/website#readme",
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-navigation": "^0.3.5",
    "@11ty/eleventy-plugin-vite": "^4.0.0",
    "html-minifier": "^4.0.0",
    "sass": "^1.79.3",
    "vite-plugin-html": "^3.2.2"
  }
}
